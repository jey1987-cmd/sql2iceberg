# Copy to .env (git-ignored) and fill in. Never commit .env. Only names and placeholders belong in this file.
# Snowflake (key-pair login shown; or SNOWFLAKE_PASSWORD, or SNOWFLAKE_AUTHENTICATOR=externalbrowser)
SNOWFLAKE_ACCOUNT=<orgname>-<account_name>
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=C:/path/to/rsa_key.p8
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=<warehouse>
SNOWFLAKE_DATABASE=<database>
SNOWFLAKE_SCHEMA=<schema>

# AWS: credentials come from your AWS profile, never from this file
AWS_PROFILE=<profile>
AWS_REGION=us-east-1
# Behind a TLS-inspecting proxy only: path to your corporate CA bundle (PEM)
# AWS_CA_BUNDLE=C:/path/to/ca-bundle.pem

# Used by the example scripts under scripts/
SF2ICE_S3_BUCKET=<your-bucket>
SF2ICE_S3_PREFIX=warehouse
SF2ICE_SNOWFLAKE_ROLE_ARN=arn:aws:iam::<aws-account-id>:role/<role-name>
